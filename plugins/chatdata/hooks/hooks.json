{
  "description": "ChatData discovery and opt-in, content-free workflow counting.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-start.js"],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/telemetry.py", "flush", "--silent"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^chatdata:(analysis-review|causal-inference|data-quality|data-science|decision-brief|experiment-analysis|experiment-design|exploratory-analysis|forecasting|funnel-analysis|metric-definition|predictive-modeling|retention|root-cause|sql-review|visualization)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/telemetry.py", "claude-hook"],
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/telemetry.py", "claude-hook"],
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/telemetry.py", "claude-hook"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
